# Obrigatórios
DATABASE_USER=
DATABASE_PASSWORD=
# Chave do provedor de IA escolhido em AI_BASE_URL (por padrão, a OpenAI).
AI_API_KEY=

# Opcionais:

# Provedor de IA: O projeto é compativel com:
#   OpenAI (padrão): https://api.openai.com
#   Groq: https://api.groq.com/openai
# AI_BASE_URL=https://api.openai.com

# Voz do Claudinho:
#   true : OpenAI fala com a voz da OpenAI e Groq fala com o Kokoro.
#   false: o servidor não gera áudio e o app lê as respostas com a voz do dispositivo (expo-speech).
# AI_SPEECH=true

# JWT_SECRET=
