DATABASE_USER=postgres
DATABASE_PASSWORD=
JWT_SECRET=

# Provedor de IA: a URL define o provedor e, com ele, os modelos de chat e de transcrição.
#   OpenAI: https://api.openai.com
#   Groq: https://api.groq.com/openai
AI_BASE_URL=https://api.groq.com/openai
AI_API_KEY=

# Voz da IA para o Claudinho (padrão: true).
#   true : OpenAI fala com a voz da OpenAI; Groq fala com o Kokoro, um servidor de voz local (serviço do compose).
#   false: o servidor não gera áudio e o app lê as respostas com a voz do aparelho.
AI_SPEECH=true
