# Copie para .env. Variáveis EXPO_PUBLIC_* são lidas na hora do build: reinicie o Expo com `npx expo start -c` ao mudar.
#
# URL do backend:
#   Web e emulador iOS ........ http://localhost:8080 (padrão, pode deixar em branco)
#   Celular físico (Expo Go) .. URL do túnel (https://xxxx.trycloudflare.com) ou o IP da máquina (http://192.168.0.10:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080
